Source: puppet-enhancements
Section: misc
Priority: extra
Maintainer: Benedikt Trefzer <benedikt.trefzer@cirrax.com>
Build-Depends: debhelper (>= 9),
               ruby,
Standards-Version: 3.9.8

Package: puppet-enhance-links
Architecture: any
Depends:  ${misc:Depends},
          puppet-agent,
Description: create several links to use puppetlabs puppet-agent
 create links to use the virtual environment installed
 by puppetlabs puppet-agent.
 links created are puppet and eyaml

Package: puppet-enhance-miniportile2
Architecture: any
Depends:  ${misc:Depends},
          puppet-agent,
Description: install ruby gem mini_portile2 into puppet-agent
 Take mini_portile2 and install it into the
 virtual ruby environment of the puppet-agent (in /opt)
 .
 This package is a requirement to install gpgme into the
 puppet-agent environment

Package: puppet-enhance-hiera-eyaml-gpg-source
Architecture: any
Depends:  ${misc:Depends},
Description: GPG encryption backend for the hiera-eyaml module (source)
 installs the actual gem into /usr/src/rubygems-hiera-eyaml-gpg
 used to install for puppetserver and puppet-agent.
 .
 installs the gem into /usr/src/rubygems-hiera-eyaml-gpg

Package: puppet-enhance-hiera-eyaml-gpg-agent
Architecture: any
Depends:  ${misc:Depends},
          puppet-enhance-hiera-eyaml-gpg-source,
          puppet-enhance-gpgme,
          puppet-agent,
Description: GPG encryption backend for the hiera-eyaml module (for puppet-agent)
 installs the GPG encryption backend into puppet-agent virtual
 environment.
 .
 installs into virtual ruby environment of the puppet-agent (in /opt)
 from puppetlabs

Package: puppet-enhance-hiera-eyaml-gpg-server
Architecture: any
Depends:  ${misc:Depends},
          puppet-enhance-hiera-eyaml-gpg-source,
          puppetserver,
          puppet-enhance-ruby-gpg,
Description: GPG encryption backend for the hiera-eyaml module (for puppetserver)
 installs the GPG encryption backend into puppetserver virtual
 environment.
 .
 installs into virtual ruby environment of the puppetserver (in /opt)
 from puppetlabs

Package: puppet-enhance-ruby-gpg
Architecture: any
Depends:  ${misc:Depends},
          puppetserver,
Description: Ruby wrapper for the gpg binary (puppetserver)
 Ruby wrapper for the gpg binary.
 You probably want to be using the ruby-gpgme gem instead which
 is more powerful but has more dependencies.
 .
 installs into virtual ruby environment of the puppetserver (in /opt)
 from puppetlabs

Package: puppet-enhance-gpgme
Architecture: any
Depends:  ${misc:Depends},
          puppet-agent,
          puppet-enhance-miniportile2,
          gcc,
          make,
          libgpgme-dev,
Description: ruby interface to GnuPG Made Easy (for puppet-agent)
 GnuPG Made Easy (GPGME) is a library designed to make access to GnuPG 
 easier for applications. It provides a High-Level Crypto API for 
 encryption, decryption, signing, signature verification 
 and key management.
 .
 installs into virtual ruby environment of the puppet-agent (in /opt)
 from puppetlabs
